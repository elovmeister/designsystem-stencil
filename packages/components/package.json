{
  "name": "@lm-prototype-stencil/components",
  "version": "0.6.0",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "customElements": "dist/components/index.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*",
      "default": "./dist/components/*"
    },
    "./dist/components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "default": "./loader/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "stencil build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@lm-prototype-stencil/tokens": "workspace:*",
    "@lm-prototype-stencil/icons": "workspace:*"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.3.1",
    "@stencil/core": "^4.43.4",
    "@stencil/react-output-target": "^1.5.1",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/web-components": "^8.6.14",
    "@storybook/web-components-vite": "8.6.14",
    "lit": "^3.3.2",
    "storybook": "8.6.14",
    "typescript": "^5.5.4"
  }
}