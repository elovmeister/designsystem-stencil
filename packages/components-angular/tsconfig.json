{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@lm-prototype-stencil/components": [
        "../components/dist/types/index.d.ts"
      ],
      "@lm-prototype-stencil/components/dist": [
        "../components/dist/types/index.d.ts"
      ],
      "@lm-prototype-stencil/icons/dist/types/components": [
        "../icons/dist/types/components.d.ts"
      ],
      "@lm-prototype-stencil/icons/dist/components/*": [
        "../icons/dist/components/*"
      ],
      "@lm-prototype-stencil/icons/lm-prototype-stencil-icon": [
        "../icons/dist/components/lm-prototype-stencil-icon.d.ts"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*"
  ],
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
