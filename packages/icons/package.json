{
  "name": "@lm-prototype-stencil/icons",
  "version": "0.4.0",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*"
    },
    "./lm-prototype-stencil-icon": {
      "types": "./dist/components/lm-prototype-stencil-icon.d.ts",
      "import": "./dist/components/lm-prototype-stencil-icon.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.es2017.js",
      "require": "./loader/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "loader"
  ],
  "scripts": {
    "build": "stencil build && node fix-icons.mjs",
    "dev": "stencil build --watch"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.3.1",
    "@stencil/core": "^4.0.0",
    "@stencil/react-output-target": "^1.5.1",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
